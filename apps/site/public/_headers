# script-src needs 'unsafe-inline': Next's App Router ships required inline
# <script>self.__next_f.push(...)</script> tags carrying the RSC/hydration
# payload, generated per build with no stable hash and no server available
# under output: "export" to mint a per-request nonce. Without it, React
# never hydrates and every client component (recipe tabs, copy buttons) is
# dead on load. 'self' still blocks any externally-hosted (src=) script, so
# this doesn't open the door to third-party script injection.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' https://github.com https://img.shields.io data:; font-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
  Strict-Transport-Security: max-age=63072000; includeSubDomains
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin

# next/og's ImageResponse routes ship without a file extension (Next's own
# server sets Content-Type at request time; a static host can't). Cloudflare
# Pages would otherwise serve these as application/octet-stream, and
# X-Content-Type-Options: nosniff above stops browsers/crawlers from
# guessing around that, so link previews and the apple touch icon would
# silently break without these overrides.
/opengraph-image
  Content-Type: image/png

/twitter-image
  Content-Type: image/png

/apple-icon
  Content-Type: image/png

# Next fingerprints everything under _next/static/ by content hash, so a
# path only ever refers to one immutable file — safe to cache for a year.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable
