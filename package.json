{
  "name": "better-auth-mongoose-monorepo",
  "private": true,
  "description": "Monorepo for better-auth-mongoose: a Mongoose-native database adapter for Better Auth, plus a tenant-scoping plugin.",
  "type": "module",
  "license": "MIT",
  "author": "Ashwin Sathian",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AshwinSathian/better-auth-mongoose.git"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,md,json,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,json,yml}\"",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "turbo run build && changeset publish",
    "prepare": "husky"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.0",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.1",
    "eslint-config-next": "^16.3.1",
    "husky": "^9.1.0",
    "lint-staged": "^17.3.0",
    "prettier": "^3.4.0",
    "turbo": "^2.3.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.67.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{md,json,yml}": [
      "prettier --write"
    ]
  }
}
